APP_NAME=CampusToday
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/api

# Primary database (shared MariaDB `asimos` with SchoolCRM web)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asimos
DB_USERNAME=root
DB_PASSWORD=

# PHPUnit uses sqlite :memory: via phpunit.xml — no DB_* override needed for tests.

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# JWT auth (required)
JWT_SECRET=
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# Login rate limiting (requests per minute per IP)
LOGIN_RATE_LIMIT=10

# Optional: dual-stack regression script targets
# API_BASE_URL=http://127.0.0.1:8080/v1
# VERIFY_USER=student.test
# VERIFY_PASS=secret
# VERIFY_TEACHER=teacher.test
# VERIFY_DATE=2026-09-04
